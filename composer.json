{
    "name": "telecloud/telegram-gateway",
    "description": "Small framework-agnostic PHP client for Telegram Gateway verification messages.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "guzzlehttp/guzzle": "^7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Telecloud\\TelegramGateway\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Telecloud\\TelegramGateway\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
